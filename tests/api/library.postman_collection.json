    {
      "name": "PM-05 新增库存1图书并提取编号",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/books/add",
        "description": "{\"oracle\": \"create_book\", \"case_id\": \"PM-05\", \"title\": \"新增库存1图书并提取编号\"}",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "book_name",
              "value": "{{book_name}}",
              "type": "text"
            },
            {
              "key": "author",
              "value": "合成作者",
              "type": "text"
            },
            {
              "key": "category",
              "value": "Postman补测",
              "type": "text"
            },
            {
              "key": "stock",
              "value": "1",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "{ const $=require('cheerio').load(pm.response.text());",
              "const rows=$('tbody tr').toArray().filter(el=>$(el).find('td').eq(1).text().trim()===pm.collectionVariables.get('book_name'));",
              "pm.test('目标合成记录唯一',()=>pm.expect(rows.length).to.eql(1));",
              "if(rows.length===1) pm.collectionVariables.set('book_id',$(rows[0]).find('td').eq(0).text().trim()); }",
              "const $=require('cheerio').load(pm.response.text());",
              "const row=$('tbody tr').toArray().find(el=>$(el).find('td').eq(1).text().trim()===pm.collectionVariables.get('book_name'));",
              "pm.test('目标图书库存为1',()=>{pm.expect(row).to.exist; pm.expect(Number($(row).find('td').eq(4).text().trim())).to.eql(1);});"
            ]
          }
        }
      ]
    },
