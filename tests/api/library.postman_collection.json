{
  "info": {
    "name": "图书系统-Postman真实补测-31步",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "2026-09-19补充实践；独立合成数据；31个请求步骤，不混入历史70/101项统计。Flask表单接口返回HTML，使用Cookie会话和业务断言。"
  },
  "item": [
    {
      "name": "PM-01 退出清空登录态",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/logout",
        "description": "{\"oracle\": \"unchanged\", \"case_id\": \"PM-01\", \"title\": \"退出清空登录态\"}"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const tag='PM_'+Date.now()+'_'+Math.floor(Math.random()*10000);",
              "pm.collectionVariables.set('run_tag',tag);",
              "pm.collectionVariables.set('book_name',tag+'_BOOK');",
              "pm.collectionVariables.set('reader_a',tag+'_A');",
              "pm.collectionVariables.set('reader_b',tag+'_B');",
              "pm.collectionVariables.set('phone_a','18'+Date.now().toString().slice(-9));",
              "pm.collectionVariables.set('phone_b','17'+Date.now().toString().slice(-9));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 302',()=>pm.response.to.have.status(302));",
              "pm.test('退出跳转登录页',()=>pm.expect(pm.response.headers.get('Location')).to.eql('/login'));"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "followRedirects": false
      }
    },
    {
      "name": "PM-02 未登录访问图书被拦截",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/books",
        "description": "{\"oracle\": \"unchanged\", \"case_id\": \"PM-02\", \"title\": \"未登录访问图书被拦截\"}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('业务提示符合预期',()=>pm.expect(pm.response.text()).to.include(\"请输入用户名\"));"
            ]
          }
        }
      ]
    },
