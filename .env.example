# 只连接专用测试数据库，公开仓库不提供任何真实口令。
BOOK_MYSQL_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/book_manage_test_demo?charset=utf8mb4
BOOK_SQLSERVER_URL=mssql+pyodbc://USER:PASSWORD@127.0.0.1/book_manage_test_demo?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
BOOK_POSTGRESQL_URL=postgresql+pg8000://USER:PASSWORD@127.0.0.1:5432/book_manage_test_demo
BOOK_SECRET_KEY=replace-with-a-random-local-value
BOOK_BASE_URL=http://127.0.0.1:5001
BOOK_ADMIN_PASSWORD=replace-locally
BOOK_OPERATOR_PASSWORD=replace-locally
BOOK_VIEWER_PASSWORD=replace-locally
